{
  "name": "dsh-kb-curator",
  "version": "0.1.2",
  "description": "Installable DeepSeek Harness bundle contributing the kb-curator skill: a local, three-layer knowledge base (L1 originals, L2 memory, L3 topic pages) with a mandatory human review gate, source-ranked conflict arbitration, and a bundled dependency-free PowerShell engine.",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "assets",
    "scripts/check-assets.mjs",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node scripts/check-assets.mjs",
    "check": "node scripts/check-assets.mjs"
  },
  "license": "MIT",
  "author": "Mark-mph",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-skill": ">=0.1.0-rc.1 <0.2.0-0"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "dsh-market",
    "cordis",
    "skill",
    "knowledge-base",
    "kb",
    "review-gate",
    "arbitration"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mark-mph/dsh-kb-curator.git"
  },
  "homepage": "https://github.com/Mark-mph/dsh-kb-curator#readme",
  "bugs": {
    "url": "https://github.com/Mark-mph/dsh-kb-curator/issues"
  }
}
